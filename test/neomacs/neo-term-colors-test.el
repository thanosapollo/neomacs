(ert-deftest neo-term-colors-legacy-public-constructor-refuses-revoked-owner ()
  (require 'neo-term)
  (let ((foreign (generate-new-buffer " *palette-foreign*"))
        (initial (current-buffer))
        (neo-term--terminals (make-hash-table :test 'eql))
        created)
    (unwind-protect
        (dolist (revoke '(switch mode))
          (switch-to-buffer initial)
          (cl-letf (((symbol-function 'neomacs-terminal-create)
                     (lambda (&rest _) (setq created t) 41))
                    ((symbol-function 'neo-term--ensure-palettes)
                     (lambda ()
                       (if (eq revoke 'switch) (switch-to-buffer foreign)
                         (fundamental-mode)))))
            (should-error (neo-term))
            (should-not created)
            (should (= (hash-table-count neo-term--terminals) 0))
            (should-not (buffer-local-value 'neo-term--id foreign))))
      (switch-to-buffer initial)
      (when (buffer-live-p foreign) (kill-buffer foreign)))))

(provide 'neo-term-colors-test)
